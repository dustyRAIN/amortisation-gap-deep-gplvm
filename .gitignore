__pycache__/
*.pyc
.venv/

# Frey Faces is a third-party dataset — fetch it, do not redistribute it.
# src/data.py:frey_faces has the URL.
data/

# Mid-run training checkpoints (model + optimiser + RNG state). Large, and
# regenerated by re-running. Results themselves ARE committed: every number in
# the report is traceable to results/*.json.
results/ckpt_*.pt
report/*.aux
report/*.bbl
report/*.blg
report/*.log
report/*.out
.DS_Store

# in-flight experiment output; committed when the run completes
results/dense_ablation.json
results/*.backup.json
